<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite thread-count="5" name="Login Suite" parallel="methods">
    <listeners>
        <listener class-name="core.listeners.TestListener" />
    </listeners>
    <test verbose= "1" name="Login valid scenarios">
        <classes>
            <class name="tests.LoginTest">
                <methods>
                    <include name="fillLoginWithValidCredentials"/>
                </methods>
            </class>
        </classes>
    </test>
    <test verbose= "1" name="Login invalid scenarios">
        <classes>
            <class name="tests.LoginTest">
                <methods>
                    <include name="fillLoginWithInvalidCredentials"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>